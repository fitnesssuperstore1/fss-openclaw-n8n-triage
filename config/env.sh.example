# config/env.sh.example
#
# Copy to `config/env.sh` and fill in real values. `env.sh` itself is in
# .gitignore — never commit real values. This file is the shell-script
# counterpart of `.env.example` (n8n / Docker use .env; the bash bridge
# scripts source this file).
#
# Sourced by:
#   - bin/triage-pipeline.sh
#   - bin/triage-server.py (via subprocess.Popen env)
#   - bin/monday-card.sh
#   - bin/start-services.sh

# ============================================================================
# Model selection
# ============================================================================

# Default model for any OpenClaw skill that doesn't have a per-skill override.
export OPENCLAW_MODEL="${OPENCLAW_MODEL:-openai/gpt-5.5}"

# Optional per-skill model overrides. The cheaper bounded-classification
# skills (scope_gate, classify_email, select_sop) can use a smaller model;
# the quality-sensitive skills (draft_response, audit_check) should stay on
# the default. Leave commented to use the default for all.
# export OPENCLAW_MODEL_SCOPE="openai/gpt-5.4"
# export OPENCLAW_MODEL_CLASSIFY="openai/gpt-5.4"
# export OPENCLAW_MODEL_SELECT="openai/gpt-5.4"
# export OPENCLAW_MODEL_DRAFT="openai/gpt-5.5"
# export OPENCLAW_MODEL_AUDIT="openai/gpt-5.5"

# ============================================================================
# Gmail (the inbox being triaged)
# ============================================================================

# The email address whose inbox n8n's Gmail Trigger watches. Used as the From:
# for holding replies and as the identity stamped on every Monday card.
export GMAIL_USER="${GMAIL_USER:-triage@example.com}"

# ============================================================================
# Monday.com
# ============================================================================

# Board id of the CS Triage board (number after /boards/ in the Monday URL).
export MONDAY_BOARD_ID="${MONDAY_BOARD_ID:-REPLACE_WITH_REAL_BOARD_ID}"

# Approval status column id. Holds the labels:
#   Awaiting Review | Approved | Rejected | Draft Ready | Sent
# Found via: query { boards(ids: <BOARD_ID>) { columns { id title type } } }
export MONDAY_APPROVAL_COL_ID="${MONDAY_APPROVAL_COL_ID:-REPLACE_WITH_REAL_COL_ID}"

# Gmail Message ID text column. The idempotency check (Milestone 1 Rule 6,
# one email = one Monday item) writes the originating Gmail message_id here
# on every card, and looks it up before each create to skip duplicates.
export MONDAY_GMAIL_MSGID_COL_ID="${MONDAY_GMAIL_MSGID_COL_ID:-REPLACE_WITH_REAL_COL_ID}"

# Optional fallback group id used only when the lane→group_id map in
# config/monday-groups.json has no entry for the email's classified lane.
# export MONDAY_GROUP_ID="topics"

# ============================================================================
# Secrets paths (files are git-ignored; never commit their contents)
# ============================================================================

# These paths are where the bridge looks for raw key material on the host.
# The Docker bridge image mounts ~/secrets read-only. Override if your
# deployment uses a different secrets directory.
# export SECRETS_DIR="$HOME/secrets"
# triage-chain.py reads $SECRETS_DIR/openai.key (and anthropic.key) directly.
# monday-card.sh reads $SECRETS_DIR/monday.key directly.
