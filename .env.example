# Fitness Superstore — triage system .env template
#
# Copy this file to `.env` and fill in the real values for your deployment.
# The .env file itself is git-ignored — never commit real values. If you
# accidentally commit a real key, rotate it immediately (git history is
# forever).
#
# Variables marked REQUIRED must be set or the stack will not start.
# Variables marked OPTIONAL have sane defaults but can be overridden.

# ===========================================================================
# OpenAI / Anthropic — the model behind every OpenClaw skill call
# ===========================================================================

# REQUIRED — used by triage-chain.py when it shells out to OpenClaw. The
# project key (sk-proj-…) needs sufficient quota for ~5 calls per inbound
# email × your expected volume. Mounted into the bridge container and also
# written to ~/secrets/openai.key for the chain.
OPENAI_API_KEY=sk-replace-me

# OPTIONAL — fall back to Anthropic if you prefer Claude models for some
# skills. Same shape as OpenAI. Leave blank if not using.
ANTHROPIC_API_KEY=

# OPTIONAL — default OpenClaw model. The chain overrides per skill via
# OPENCLAW_MODEL_{CLASSIFY,SELECT,DRAFT,AUDIT,SCOPE} if you want different
# tiers per skill.
OPENCLAW_MODEL=openai/gpt-5.5

# ===========================================================================
# Google OAuth — Gmail trigger + Drive SOP fetch (used by n8n credentials)
# ===========================================================================

# REQUIRED — set these on the Google Cloud Console project that owns the
# OAuth client. Add `https://<your-n8n-host>/rest/oauth2-credential/callback`
# to the Authorized redirect URIs.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REFRESH_TOKEN=replace-me

# OPTIONAL — used by the bridge if it ever needs to bypass n8n and call
# Gmail directly. Phase 1 doesn't need this; leave blank.
GOOGLE_API_KEY=

# REQUIRED — Google Drive folder ids for the approved SOP library. The n8n
# Drive "Search files and folders" node scopes its query to these folders ONLY
# (B10: no Drive-wide filename-prefix search). Copy each id from the folder URL
# drive.google.com/drive/folders/<THIS_ID>. Active holds the SOP-* files,
# Archived the ARCH-* files, Reference the REF-* files.
SOP_ACTIVE_FOLDER_ID=replace-me
SOP_ARCHIVED_FOLDER_ID=replace-me
SOP_REFERENCE_FOLDER_ID=replace-me

# ===========================================================================
# Monday.com — board, columns, credentials
# ===========================================================================

# REQUIRED — generate from your Monday profile (Developers → My access tokens).
# Stored at ~/secrets/monday.key on the host so the bridge scripts read it.
MONDAY_API_TOKEN=replace-me

# REQUIRED — the CS Triage board id (the long number after /boards/ in the URL).
MONDAY_BOARD_ID=replace-me

# REQUIRED — id of the Approval status column on the board. Has these labels:
# "Awaiting Review", "Approved", "Rejected", "Draft Ready", "Sent". Find it via:
#   query { boards(ids: <BOARD_ID>) { columns { id title type } } }
MONDAY_APPROVAL_COL_ID=replace-me

# REQUIRED — id of the Gmail Message ID text column on the board. Used by the
# idempotency check (one Gmail email = one Monday item) in monday-card.sh.
MONDAY_GMAIL_MSGID_COL_ID=replace-me

# OPTIONAL — fallback group id if the lane→group_id map in
# config/monday-groups.json has no entry for a given lane. Useful for catching
# misconfigurations during setup.
MONDAY_GROUP_ID=topics

# ===========================================================================
# n8n — workflow engine
# ===========================================================================

# REQUIRED — public hostname for n8n. Used by Google OAuth callbacks, the
# Monday webhook subscription URL, and the n8n editor itself.
N8N_HOST=n8n.example.com

# REQUIRED — public URL n8n constructs for inbound webhooks (Monday → WF2,
# Gmail OAuth callbacks). Include trailing slash.
N8N_WEBHOOK_URL=https://n8n.example.com/

# REQUIRED — owner account for the n8n editor. n8n 2.x requires login via its
# built-in user management; create this owner on first launch. Strong password.
N8N_USER=admin
N8N_PASSWORD=replace-me

# REQUIRED — n8n credential encryption key. MUST be set and kept stable, or n8n
# regenerates a random key each restart and every stored credential breaks.
# Generate one with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=replace-me-with-a-32+char-random-string

# OPTIONAL — n8n internal port. The Traefik route and docker-compose both use
# 8080; change all three together if 8080 is taken. n8n binds 127.0.0.1 only.
N8N_PORT=8080

# ===========================================================================
# Gmail account being triaged
# ===========================================================================

# REQUIRED — the inbox the Gmail trigger watches. The triage chain uses this
# as the From: when drafting holding replies and as the audit-log address.
GMAIL_USER=triage@example.com

# ===========================================================================
# OpenClaw gateway (host-native, lives outside Docker for now)
# ===========================================================================

# OPTIONAL — port the OpenClaw gateway listens on. Default 18789. Used by the
# control UI for interactive sessions and by triage-chain.py for skill calls.
OPENCLAW_GATEWAY_PORT=18789

# OPTIONAL — gateway token if you've enabled gateway auth. Required for the
# Control UI handshake when allowInsecureAuth=false.
OPENCLAW_GATEWAY_TOKEN=replace-me

# ===========================================================================
# Locale / timing
# ===========================================================================

# OPTIONAL — timezone n8n uses for cron schedules and log timestamps.
TIMEZONE=America/New_York
