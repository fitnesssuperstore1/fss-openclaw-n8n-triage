    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst sops = [];\n\nfor (let i = 0; i < items.length; i++) {\n  const item = items[i];\n  const buf = await this.helpers.getBinaryDataBuffer(i, 'data');\n  const content = buf.toString('utf-8');\n\n  const name = item.json.name || '';\n  let status = 'Reference';\n  if (name.startsWith('SOP-')) status = 'Active';\n  else if (name.startsWith('ARCH-')) status = 'Archived';\n\n  // Extract the SOP-/REF-/ARCH-NN id from the filename — the Drive file ID\n  // is not what the select_sop schema expects.\n  const m = name.match(/^((?:SOP|REF|ARCH)-\\d{2})/);\n  const sopId = m ? m[1] : null;\n\n  sops.push({ id: sopId, drive_id: item.json.id, name, status, content });\n}\n\nconst email = $('Normalize email').first().json.payload;\nreturn [{ json: { email, sops } }];"
      },
