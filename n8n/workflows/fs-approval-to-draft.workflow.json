{
  "name": "FS — Approval to Draft (Phase 1.5)",
  "description": null,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "monday-approval",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "6c9e200e-ed7c-491b-8cc9-b907411d01ce",
      "name": "Monday Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -448,
        128
      ],
      "webhookId": "monday-approval-wf2",
      "notes": "Public endpoint Monday POSTs to on every event. After import, take the production URL and subscribe Monday's create_webhook to it."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-challenge",
              "leftValue": "={{ $json.body.challenge !== undefined && $json.body.challenge !== null }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "7d438024-306b-4a1a-872b-2e5bd5f04eaa",
      "name": "Is Challenge?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        -224,
        128
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { challenge: $('Monday Webhook').item.json.body.challenge } }}",
        "options": {}
      },
      "id": "f88af175-7bae-4cde-9ac3-ea2eb8890408",
      "name": "Echo Challenge",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ],
      "notes": "Monday's one-time subscription handshake: it sends a {challenge:'<token>'} POST and expects the same token echoed back."
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 200
        }
      },
      "id": "2cf02bea-3d92-4ef0-9ad8-d1854badad2a",
      "name": "Ack 200",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        0,
        256
      ],
      "notes": "Acknowledge Monday immediately, then keep processing async."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-col",
              "leftValue": "={{ $('Monday Webhook').item.json.body.event.columnId }}",
              "rightValue": "={{ $env.MONDAY_APPROVAL_COL_ID }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            },
            {
              "id": "cond-approved",
              "leftValue": "={{ $('Monday Webhook').item.json.body.event.value.label.text }}",
              "rightValue": "Approved",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "6e085266-8765-4082-b082-ae3398a2e827",
      "name": "Is Approval=Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        256
      ],
      "notes": "Only act on changes to the Approval status column when the new value is 'Approved'. The Approval column is identified by $env.MONDAY_APPROVAL_COL_ID on the board $env.MONDAY_BOARD_ID."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "API-Version",
              "value": "2024-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'query($i:[ID!]){ items(ids:$i){ id name updates(limit:1){ body created_at } } }', variables: { i: [String($('Monday Webhook').item.json.body.event.pulseId)] } }) }}",
        "options": {}
      },
      "id": "5947e9ad-1dc1-4a10-b44d-8a7d93f543fa",
      "name": "Fetch card update",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        192
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "REPLACE_ME"
        }
      },
      "notes": "Pulls the most recent update body from the approved Monday card — that's where monday-card.sh posts the decision text + the [DECISION JSON] block."
    },
    {
      "parameters": {
        "jsCode": "// monday-card.sh appends a section that looks like:\n//   ...other text...\n//   [DECISION JSON]\n//   {\"primary_lane\":...,\"draft\":{...},...}\n\nconst payload = $input.first().json;\nconst body = payload?.data?.items?.[0]?.updates?.[0]?.body || '';\n\nconst marker = '[DECISION JSON]';\nconst idx = body.indexOf(marker);\nif (idx === -1) {\n  throw new Error('No [DECISION JSON] block found on this card. Update monday-card.sh to append the decision JSON.');\n}\nconst jsonText = body.slice(idx + marker.length).trim();\n// monday's update bodies sometimes wrap in HTML; strip simple tags.\nconst cleaned = jsonText.replace(/<[^>]+>/g, '').replace(/&quot;/g, '\"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');\n\nlet decision;\ntry {\n  decision = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Could not parse decision JSON: ' + e.message + '\\nGot: ' + cleaned.slice(0, 200));\n}\n\nconst pulseId = $('Monday Webhook').item.json.body.event.pulseId;\nreturn [{ json: { decision, pulseId } }];"
      },
      "id": "0a43d93e-7d2a-4ccb-8a6a-2041f7c6279c",
      "name": "Parse decision JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        192
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "cond-has-draft",
              "leftValue": "={{ !!$json.decision.draft && !!$json.decision.draft.body }}",
              "rightValue": "true",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a4329052-2dc4-4281-89f8-b6fc102a4526",
      "name": "Holding draft exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        192
      ],
      "notes": "Some escalations have a holding draft (e.g. ACH neutral acknowledgment); others have draft=null. Skip Gmail draft creation if null."
    },
    {
      "parameters": {
        "resource": "draft",
        "subject": "={{ $json.decision.draft.subject }}",
        "message": "={{ $json.decision.draft.body }}",
        "options": {
          "threadId": "={{ $json.decision.email_metadata?.threadId || '' }}",
          "sendTo": "={{ $json.decision.draft.to?.value?.[0]?.address || $json.decision.draft.to?.text || $json.decision.draft.to }}"
        }
      },
      "id": "6c3adec6-3e93-4102-ab0f-48a2d7722484",
      "name": "Create approved Gmail draft",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.2,
      "position": [
        1120,
        64
      ],
      "webhookId": "gmail-draft-wf2",
      "credentials": {
        "gmailOAuth2": {
          "id": "",
          "name": "REPLACE_ME"
        }
      },
      "notes": "Same Gmail credential as the main workflow (np9bdfleWVRNhyXu). Creates the holding draft — human still has to click Send."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.monday.com/v2",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "API-Version",
              "value": "2024-10"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ query: 'mutation($b:ID!,$i:ID!,$c:String!,$v:String!){ change_simple_column_value(board_id:$b,item_id:$i,column_id:$c,value:$v){ id } }', variables: { b: $env.MONDAY_BOARD_ID, i: String($('Parse decision JSON').item.json.pulseId), c: $env.MONDAY_APPROVAL_COL_ID, v: 'Draft Ready' } }) }}",
        "options": {}
      },
      "id": "cf8b4d89-89fa-47b6-825c-8da2358edbaa",
      "name": "Flip Approval → Draft Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1344,
        192
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "REPLACE_ME"
        }
      },
      "notes": "Update the card's Approval column to 'Draft Ready' so it doesn't re-fire on accidental re-clicks, and so the CS Lead sees the card moved forward."
    }
  ],
