{"updatedAt":"2026-06-09T11:31:08.645Z","createdAt":"2026-06-09T10:25:22.696Z","id":"0ufsbnCLYbG6Qqjg","name":"FS — Approval to Draft (Phase 1.5)","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"monday-approval","responseMode":"responseNode","options":{}},"id":"6c9e200e-ed7c-491b-8cc9-b907411d01ce","name":"Monday Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[-448,128],"webhookId":"monday-approval-wf2","notes":"Public endpoint Monday POSTs to on every event. After import, take the production URL and subscribe Monday's create_webhook to it."},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"cond-challenge","leftValue":"={{ $json.body.challenge !== undefined && $json.body.challenge !== null }}","rightValue":"true","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"7d438024-306b-4a1a-872b-2e5bd5f04eaa","name":"Is Challenge?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[-224,128]},{"parameters":{"respondWith":"json","responseBody":"={{ { challenge: $('Monday Webhook').item.json.body.challenge } }}","options":{}},"id":"f88af175-7bae-4cde-9ac3-ea2eb8890408","name":"Echo Challenge","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[0,0],"notes":"Monday's one-time subscription handshake: it sends a {challenge:'<token>'} POST and expects the same token echoed back."},{"parameters":{"respondWith":"noData","options":{"responseCode":200}},"id":"2cf02bea-3d92-4ef0-9ad8-d1854badad2a","name":"Ack 200","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.1,"position":[0,256],"notes":"Acknowledge Monday immediately, then keep processing async."},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"cond-col","leftValue":"={{ $('Monday Webhook').ite