 monday-card.sh to append the decision JSON.');\n}\nconst jsonText = body.slice(idx + marker.length).trim();\n// monday's update bodies sometimes wrap in HTML; strip simple tags.\nconst cleaned = jsonText.replace(/<[^>]+>/g, '').replace(/&quot;/g, '\"').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>');\n\nlet decision;\ntry {\n  decision = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error('Could not parse decision JSON: ' + e.message + '\\nGot: ' + cleaned.slice(0, 200));\n}\n\nconst pulseId = $('Monday Webhook').item.json.body.event.pulseId;\nreturn [{ json: { decision, pulseId } }];"},"id":"0a43d93e-7d2a-4ccb-8a6a-2041f7c6279c","name":"Parse decision JSON","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,192]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"cond-has-draft","leftValue":"={{ !!$json.decision.draft && !!$json.decision.draft.body }}","rightValue":"true","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}},"id":"a4329052-2dc4-4281-89f8-b6fc102a4526","name":"Holding draft exists?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[896,192],"notes":"Some escalations have a holding draft (e.g. ACH neutral acknowledgment); others have draft=null. Skip Gmail draft creation if null."},{"parameters":{"resource":"draft","subject":"={{ $json.decision.draft.subject }}","message":"={{ $json.decision.draft.body }}","options":{"threadId":"={{ $json.decision.email_metadata?.threadId || '' }}","sendTo":"={{ $json.decision.draft.to?.value?.[0]?.address || $json.decision.draft.to?.text || $json.decision.draft.to }}"}},"id":"6c3adec6-3e93-4102-ab0f-48a2d7722484","name":"Create approved Gmail draft","type":"n8n-nodes-base.gmail","typeVersion":2.2,"position":[1120,64],"webhookId":"gmail-draft-wf2","credentials":{"gmailOAuth2":{"id":"np9bdfleWVRNhyXu","name":"Gmail account"}},"notes":"Same Gmail c