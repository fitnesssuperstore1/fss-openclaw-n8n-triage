{"updatedAt":"2026-06-15T11:07:10.683Z","createdAt":"2026-05-26T00:27:46.379Z","id":"fitnesstriage0001","name":"Fitness Superstore — Inbound Triage (Phase 1, Docker)","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"jsCode":"const it = $input.first().json;\nconst headers = it.headers || {};\nconst payload = {\n  from: it.from || headers.from || '',\n  subject: it.subject || headers.subject || '',\n  body: it.textPlain || it.text || it.textHtml || it.snippet || '',\n  threadId: it.threadId || '',\n  messageId: it.messageId || (headers && headers['message-id']) || ''\n};\nreturn [{ json: { payload } }];"},"id":"node-normalize","name":"Normalize email","type":"n8n-nodes-base.code","typeVersion":2,"position":[272,80]},{"parameters":{"method":"POST","url":"http://127.0.0.1:8088/triage","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify($json) }}","options":{"timeout":240000}},"id":"node-openclaw","name":"OpenClaw triage (HTTP bridge)","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1184,80],"notes":"POSTs the email to the host bridge (127.0.0.1:8088) which runs the fitness-triage OpenClaw skill, creates the Gmail DRAFT (IMAP append, never sends) and the Monday card, and returns the routing-decision JSON. Reachable because the container uses --network host."},{"parameters":{"jsCode":"// Surface the routing decision for visibility / downstream use.\nconst d = $('OpenClaw triage (HTTP bridge)').first().json.decision || {};\nreturn [{ json: {\n  primary_lane: d.primary_lane,\n  action: d.action,\n  approval: d.approval_required ? d.approver_role : 'none',\n  controlling_sop: d.controlling_sop,\n  sop_conflict: d.sop_conflict,\n  confidence: d.confidence,\n  draft_created: !!d.draft,\n  decision: d\n}}];"},"id":"node-surface","name":"Surface decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[2640,64]},{"parameters":{"pollTimes":{"item":[{"mode":"everyMinute"}]},"simple":false,"filters":{"readStatu